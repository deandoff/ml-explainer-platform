# Copy this file to .env.production and replace every CHANGE_ME value.

# Database
POSTGRES_USER=mlexplainer
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=mlexplainer
DATABASE_URL=postgresql://mlexplainer:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/mlexplainer

# Redis and Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Application secrets
SECRET_KEY=CHANGE_ME_APPLICATION_SECRET
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REGISTRATION_ENABLED=false

# Public application settings
ENVIRONMENT=production
CORS_ORIGINS=["https://example.com"]
MAX_UPLOAD_SIZE_BYTES=2147483648

# Start with local storage. The app_storage Docker volume must be backed up.
STORAGE_MODE=local
LOCAL_STORAGE_PATH=/app/storage

# Selectel S3 alternative:
# STORAGE_MODE=s3
# S3_ENDPOINT_URL=https://S3_ENDPOINT_FROM_SELECTEL
# S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY
# S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_KEY
# S3_BUCKET_NAME=CHANGE_ME_BUCKET
# S3_REGION=CHANGE_ME_POOL
